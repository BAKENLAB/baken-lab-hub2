+  for(const role of ['anon','authenticated']) {
+    assert.throws(()=>sql(`SET ROLE ${role}; SELECT * FROM lab_prediction_jobs;`),/permission denied/);
+    assert.throws(()=>sql(`SET ROLE ${role}; SELECT * FROM lab_prediction_health_today;`),/permission denied/);
+    assert.throws(()=>sql(`SET ROLE ${role}; SELECT lab_claim_prediction_jobs('${r}');`),/permission denied/);
+  }
+  assert.equal(sql("SET ROLE service_role; SELECT count(*) FROM lab_prediction_jobs;"),'1');
+  assert.equal(sql(`SET ROLE service_role; SELECT count(*) FROM lab_claim_prediction_jobs('${r}');`),'1');
+});
+
+t('regional claim accepts only the 60..150 minute window',()=>{
+  reset();
+  for(const [no,minutes] of [[1,59.9],[2,60.1],[3,90],[4,149.9],[5,150.1]])
+    race('大井',no,minutes);
+  enqueue();
+  assert.deepEqual(claim(run(),50).map(j=>j.race_no),[2,3,4]);
+});
+t('regional and RESCUE workers retain different windows',()=>{
+  reset();race('大井',1,30);race('大井',2,65);race('大井',3,90);enqueue();
+  assert.deepEqual(claim(run(),50).map(j=>j.race_no),[2,3]);
+  assert.deepEqual(claim(run('RESCUE'),50).map(j=>j.race_no),[1]);
+});
+t('five crashes exhaust the default budget and the sixth claim returns nothing',()=>{
+  reset();race('大井');enqueue();
+  let last;
+  for(let attempt=1;attempt<=5;attempt++) {
+    const jobs=claim(run('関東','crash-'+attempt));
+    assert.equal(jobs.length,1);last=jobs[0];
+    assert.equal(last.attempts,attempt);assert.equal(last.max_attempts,5);
+    expire(last);
+  }
+  assert.equal(claim(run()).length,0);
+  const dead=value('SELECT row_to_json(j) FROM lab_prediction_jobs j;');
+  assert.equal(dead.job_status,'DEAD');assert.equal(dead.attempts,5);
+  assert.equal(dead.claim_token,null);assert.equal(dead.worker_run_id,null);
+  assert.match(dead.last_error,/MAX_ATTEMPTS_EXCEEDED: LEASE_EXPIRED/);
+  assert.equal(claim(run('RESCUE')).length,0);
+});
+t('retry and expired leases share the same per-job attempt budget',()=>{
+  reset();race('大井');enqueue();
+  sql('UPDATE lab_prediction_jobs SET max_attempts=2;');
+  const r=run(), first=claim(r)[0];finish(r,first);
+  sql("UPDATE lab_prediction_jobs SET next_attempt_at=clock_timestamp()-interval '1 second';");
+  const last=claim(run())[0];assert.equal(last.attempts,2);expire(last);
+  assert.equal(claim(run()).length,0);
+  assert.equal(sql('SELECT job_status FROM lab_prediction_jobs;'),'DEAD');
+});
+t('configured budget above five is used by both claim and default retry completion',()=>{
+  reset();race('大井');enqueue();sql('UPDATE lab_prediction_jobs SET max_attempts=7;');
+  for(let attempt=1;attempt<=5;attempt++) {
+    const j=claim(run())[0];assert.equal(j.attempts,attempt);expire(j);
+  }
+  const r=run(), sixth=claim(r)[0];
+  assert.equal(sixth.attempts,6);assert.equal(finish(r,sixth).job_status,'RETRY');
+  sql("UPDATE lab_prediction_jobs SET next_attempt_at=clock_timestamp()-interval '1 second';");
+  const r2=run(), seventh=claim(r2)[0];
+  assert.equal(seventh.attempts,7);assert.equal(finish(r2,seventh).job_status,'DEAD');
+  assert.equal(claim(run()).length,0);
+});
+t('the last allowed live lease is not retired and may complete',()=>{
+  reset();race('大井');enqueue();sql('UPDATE lab_prediction_jobs SET max_attempts=1;');
+  const r=run(), j=claim(r)[0];assert.equal(claim(run()).length,0);
+  assert.equal(sql('SELECT job_status FROM lab_prediction_jobs;'),'CLAIMED');
+  sql("INSERT INTO official_predictions(race_date,track,race_no) SELECT race_date,track,race_no FROM official_races;");
+  assert.equal(finish(r,j,'DONE').job_status,'DONE');
+});
+t('RESCUE also retires expired jobs at their configured budget',()=>{
+  reset();race('高知',1,30);enqueue();sql('UPDATE lab_prediction_jobs SET max_attempts=1;');
+  const j=claim(run('RESCUE'))[0];expire(j);
+  assert.equal(claim(run('RESCUE')).length,0);
+  assert.equal(sql('SELECT job_status FROM lab_prediction_jobs;'),'DEAD');
+});
+t('exhausted leases outside the normal time window are still retired',()=>{
+  reset();race('大井');enqueue();sql('UPDATE lab_prediction_jobs SET max_attempts=1;');
+  const j=claim(run())[0];expire(j);
+  sql("UPDATE official_races SET post_time=clock_timestamp()+interval '180 minutes';");
+  assert.equal(claim(run()).length,0);
+  assert.equal(sql('SELECT job_status FROM lab_prediction_jobs;'),'DEAD');
+});
+t('exhaustion cleanup stays regional; RESCUE cleans up all regions',()=>{
+  reset();race('大井');race('高知');enqueue();
+  sql("UPDATE lab_prediction_jobs SET attempts=5;");
+  claim(run('関東'));
+  assert.equal(sql("SELECT job_status FROM lab_prediction_jobs WHERE track='大井';"),'DEAD');
+  assert.equal(sql("SELECT job_status FROM lab_prediction_jobs WHERE track='高知';"),'QUEUED');
+  claim(run('RESCUE'));
+  assert.equal(sql("SELECT job_status FROM lab_prediction_jobs WHERE track='高知';"),'DEAD');
+});
+t('retry override cannot raise the configured per-job cap; invalid caps are rejected',()=>{
+  reset();race('大井');enqueue();sql('UPDATE lab_prediction_jobs SET max_attempts=1;');
+  const r=run(), j=claim(r)[0];
+  assert.equal(finish(r,j,'RETRY','timeout',100).job_status,'DEAD');
+  for(const cap of [0,101])assert.throws(()=>sql(`UPDATE lab_prediction_jobs SET max_attempts=${cap};`),/check constraint/);
+});
+t('fixture prediction uniqueness rejects the same race with another circuit',()=>{
+  reset();race('大井');
+  sql("INSERT INTO official_predictions(race_date,track,race_no,circuit) SELECT race_date,track,race_no,'LOCAL' FROM official_races;");
+  assert.throws(()=>sql("INSERT INTO official_predictions(race_date,track,race_no,circuit) SELECT race_date,track,race_no,'JRA' FROM official_races;"),/duplicate key/);
+});
+t('fixture rejects invalid status, circuit and race number contracts',()=>{
+  reset();race('大井');
+  for(const status of ['DRAFT','RETRY'])assert.throws(()=>sql(`INSERT INTO official_predictions(race_date,track,race_no,status) SELECT race_date,track,race_no,'${status}' FROM official_races;`),/check constraint/);
+  assert.throws(()=>sql("INSERT INTO official_predictions(race_date,track,race_no,circuit) SELECT race_date,track,race_no,'UNKNOWN' FROM official_races;"),/check constraint/);
+  for(const table of ['official_predictions','official_races','chappy_predictions'])
+    for(const no of [0,13])assert.throws(()=>sql(`INSERT INTO ${table}(race_date,track,race_no) VALUES (current_date,'大井',${no});`),/check constraint/);
+});
+t('fixture preserves production metadata defaults and required values',()=>{
+  reset();race('大井');
+  sql("INSERT INTO official_predictions(race_date,track,race_no) SELECT race_date,track,race_no FROM official_races;");
+  const p=value('SELECT row_to_json(p) FROM official_predictions p;');
+  assert.equal(p.status,'FROZEN');assert.equal(p.circuit,'LOCAL');
+  assert.equal(p.protocol_version,'CHAPPY_DIRECT_1');assert.equal(p.model_label,'GPT-5.6 Sol');
+  assert.equal(p.source,'CHATGPT');assert.ok(p.predicted_at);assert.ok(p.frozen_at);
+  assert.throws(()=>sql('UPDATE official_predictions SET protocol_version=NULL;'),/not-null constraint/);
+});
+t('saved prediction with conflicting circuit blocks enqueue and existing queue claim',()=>{
+  reset();race('大井');enqueue();
+  sql("INSERT INTO official_predictions(race_date,track,race_no,circuit) SELECT race_date,track,race_no,'JRA' FROM official_races;");
+  assert.equal(enqueue(),0);assert.equal(claim(run()).length,0);
+});
