+-- Disposable PostgreSQL 15+ only. Never execute on a Supabase project.
+-- Types/defaults/nullability and constraints read from production on 2026-10-01.
+-- Does not replay production triggers, policies or secondary indexes.
+CREATE ROLE anon NOLOGIN;
+CREATE ROLE authenticated NOLOGIN;
+CREATE ROLE service_role NOLOGIN BYPASSRLS;
+CREATE TABLE public.official_races (
+  race_date date NOT NULL, track text NOT NULL,
+  race_no integer NOT NULL CHECK (race_no BETWEEN 1 AND 12),
+  circuit text NOT NULL DEFAULT 'LOCAL', race_name text, post_time timestamptz,
+  source text NOT NULL DEFAULT 'SCHEDULE',
+  field_payload jsonb NOT NULL DEFAULT '{}',
+  field_status text NOT NULL DEFAULT 'PENDING', field_fetched_at timestamptz,
+  prediction_status text NOT NULL DEFAULT 'PENDING',
+  prediction_attempts integer NOT NULL DEFAULT 0, prediction_last_error text,
+  market_status text NOT NULL DEFAULT 'PENDING',
+  market_attempts integer NOT NULL DEFAULT 0, market_last_error text,
+  result_status text NOT NULL DEFAULT 'PENDING',
+  result_attempts integer NOT NULL DEFAULT 0, result_last_error text,
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  PRIMARY KEY (race_date,track,race_no,circuit)
+);
+CREATE TABLE public.official_predictions (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  race_date date NOT NULL, track text NOT NULL,
+  race_no integer NOT NULL CHECK (race_no BETWEEN 1 AND 12),
+  race_name text,
+  circuit text NOT NULL DEFAULT 'LOCAL' CHECK (circuit IN ('LOCAL','JRA')),
+  post_time timestamptz,
+  protocol_version text NOT NULL DEFAULT 'CHAPPY_DIRECT_1',
+  model_label text NOT NULL DEFAULT 'GPT-5.6 Sol',
+  source text NOT NULL DEFAULT 'CHATGPT',
+  status text NOT NULL DEFAULT 'FROZEN' CHECK (status IN ('FROZEN','PUBLISHED','SETTLED')),
+  payload jsonb NOT NULL DEFAULT '{}',
+  predicted_at timestamptz NOT NULL DEFAULT now(),
+  frozen_at timestamptz NOT NULL DEFAULT now(),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (race_date,track,race_no)
+);
+CREATE TABLE public.chappy_predictions (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  race_date date NOT NULL, track text NOT NULL,
+  race_no integer NOT NULL CHECK (race_no BETWEEN 1 AND 12),
+  race_name text, picks jsonb NOT NULL DEFAULT '[]', eye jsonb, note text,
+  source text NOT NULL DEFAULT 'CHAT_PRE_RACE',
+  predicted_at timestamptz NOT NULL DEFAULT now(),
+  created_at timestamptz NOT NULL DEFAULT now(),
+  updated_at timestamptz NOT NULL DEFAULT now(),
+  UNIQUE (race_date,track,race_no)
+);
+GRANT SELECT ON public.official_races, public.official_predictions, public.chappy_predictions TO service_role;
