+-- Phase 1 only. No trigger/cron/worker or writes to existing official tables.
+BEGIN;
+
+CREATE FUNCTION public.lab_prediction_region(p_track text)
+RETURNS text LANGUAGE sql IMMUTABLE STRICT SECURITY INVOKER
+SET search_path = pg_catalog AS $$
+  SELECT CASE
+    WHEN p_track IN ('門別','帯広','盛岡','水沢') THEN '北海道東北'
+    WHEN p_track IN ('浦和','船橋','大井','川崎') THEN '関東'
+    WHEN p_track IN ('金沢','笠松','名古屋') THEN '中部'
+    WHEN p_track IN ('園田','姫路','高知','佐賀') THEN '西日本'
+  END
+$$;
+
+CREATE TABLE public.lab_worker_runs (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  worker_id text NOT NULL CHECK (length(btrim(worker_id)) BETWEEN 1 AND 200),
+  region text NOT NULL CHECK (region IN ('北海道東北','関東','中部','西日本','RESCUE')),
+  started_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  finished_at timestamptz,
+  claimed_count integer NOT NULL DEFAULT 0 CHECK (claimed_count >= 0),
+  completed_count integer NOT NULL DEFAULT 0 CHECK (completed_count >= 0),
+  retry_count integer NOT NULL DEFAULT 0 CHECK (retry_count >= 0),
+  failed_count integer NOT NULL DEFAULT 0 CHECK (failed_count >= 0),
+  last_error text,
+  status text NOT NULL DEFAULT 'RUNNING'
+    CHECK (status IN ('RUNNING','SUCCEEDED','FAILED','ABANDONED')),
+  CHECK ((status = 'RUNNING') = (finished_at IS NULL)),
+  CHECK (finished_at IS NULL OR finished_at >= started_at),
+  CHECK (completed_count + retry_count + failed_count <= claimed_count)
+);
+
+CREATE TABLE public.lab_prediction_jobs (
+  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),
+  race_date date NOT NULL,
+  track text NOT NULL,
+  race_no integer NOT NULL CHECK (race_no BETWEEN 1 AND 12),
+  circuit text NOT NULL DEFAULT 'LOCAL' CHECK (circuit = 'LOCAL'),
+  region text NOT NULL CHECK (region IN ('北海道東北','関東','中部','西日本')),
+  job_status text NOT NULL DEFAULT 'QUEUED'
+    CHECK (job_status IN ('QUEUED','CLAIMED','DONE','RETRY','DEAD')),
+  attempts integer NOT NULL DEFAULT 0 CHECK (attempts >= 0),
+  max_attempts integer NOT NULL DEFAULT 5 CHECK (max_attempts BETWEEN 1 AND 100),
+  last_error text,
+  claimed_by text,
+  claimed_at timestamptz,
+  lease_until timestamptz,
+  claim_token uuid,
+  worker_run_id uuid REFERENCES public.lab_worker_runs(id),
+  next_attempt_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  updated_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  UNIQUE (race_date, track, race_no, circuit),
+  CHECK (public.lab_prediction_region(track) IS NOT NULL
+    AND region = public.lab_prediction_region(track)),
+  CHECK (
+    (job_status = 'CLAIMED' AND claimed_by IS NOT NULL AND claimed_at IS NOT NULL
+      AND lease_until IS NOT NULL AND lease_until > claimed_at
+      AND claim_token IS NOT NULL AND worker_run_id IS NOT NULL)
+    OR
+    (job_status <> 'CLAIMED' AND claimed_by IS NULL AND claimed_at IS NULL
+      AND lease_until IS NULL AND claim_token IS NULL AND worker_run_id IS NULL)
+  )
+);
+
+CREATE INDEX lab_jobs_ready_idx ON public.lab_prediction_jobs
+  (region, next_attempt_at, race_date)
+  WHERE job_status IN ('QUEUED','RETRY','CLAIMED');
+CREATE INDEX lab_jobs_lease_idx ON public.lab_prediction_jobs (lease_until)
+  WHERE job_status = 'CLAIMED';
+CREATE INDEX lab_jobs_run_idx ON public.lab_prediction_jobs (worker_run_id)
+  WHERE job_status = 'CLAIMED';
+CREATE INDEX lab_runs_started_idx ON public.lab_worker_runs (started_at DESC);
+
+ALTER TABLE public.lab_prediction_jobs ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.lab_worker_runs ENABLE ROW LEVEL SECURITY;
+REVOKE ALL ON public.lab_prediction_jobs, public.lab_worker_runs FROM PUBLIC, anon, authenticated;
+GRANT SELECT, INSERT, UPDATE ON public.lab_prediction_jobs, public.lab_worker_runs TO service_role;
+
+CREATE FUNCTION public.lab_queue_touch_updated_at()
+RETURNS trigger LANGUAGE plpgsql SECURITY INVOKER SET search_path = pg_catalog AS $$
+BEGIN
+  NEW.updated_at := clock_timestamp();
+  RETURN NEW;
+END
+$$;
+CREATE TRIGGER lab_prediction_jobs_updated_at BEFORE UPDATE ON public.lab_prediction_jobs
+FOR EACH ROW EXECUTE FUNCTION public.lab_queue_touch_updated_at();
+
+-- Existing official predictions of ANY status block new work. Legacy saved LOCAL
+-- predictions also block work, so old FROZEN output cannot be regenerated.
+CREATE VIEW public.lab_prediction_race_state WITH (security_invoker = true) AS
+SELECT r.race_date, r.track, r.race_no, r.circuit, r.post_time, r.prediction_status,
+  public.lab_prediction_region(r.track) AS region,
+  EXISTS (
+    SELECT 1 FROM public.official_predictions p
+    -- Production uniqueness excludes circuit; conflicting circuit also blocks work.
+    WHERE (p.race_date,p.track,p.race_no) =
+      (r.race_date,r.track,r.race_no)
+  ) AS has_official_prediction,
+  EXISTS (
+    SELECT 1 FROM public.official_predictions p
+    WHERE (p.race_date,p.track,p.race_no,p.circuit) =
+      (r.race_date,r.track,r.race_no,r.circuit) AND p.status = 'FROZEN'
+  ) AS has_frozen_prediction,
+  EXISTS (
+    SELECT 1 FROM public.chappy_predictions p
+    WHERE (p.race_date,p.track,p.race_no) = (r.race_date,r.track,r.race_no)
+  ) AS has_legacy_prediction
+FROM public.official_races r WHERE r.circuit = 'LOCAL';
+
+-- Explicit, idempotent enqueue. Not scheduled and not invoked by this migration.
+CREATE FUNCTION public.lab_enqueue_prediction_jobs(p_race_date date)
+RETURNS integer LANGUAGE plpgsql SECURITY INVOKER SET search_path = pg_catalog AS $$
+DECLARE v_count integer;
+BEGIN
+  IF p_race_date IS NULL THEN RAISE EXCEPTION 'race_date is required'; END IF;
+  INSERT INTO public.lab_prediction_jobs (race_date,track,race_no,circuit,region)
+  SELECT race_date,track,race_no,circuit,region FROM public.lab_prediction_race_state
+  WHERE race_date = p_race_date AND region IS NOT NULL
+    AND prediction_status IN ('PENDING','RETRY')
+    AND NOT has_official_prediction AND NOT has_legacy_prediction
+    AND post_time > clock_timestamp()
+  ON CONFLICT (race_date,track,race_no,circuit) DO NOTHING;
+  GET DIAGNOSTICS v_count = ROW_COUNT;
+  RETURN v_count;
+END
+$$;
+
+CREATE FUNCTION public.lab_start_worker_run(p_worker_id text, p_region text)
+RETURNS uuid LANGUAGE plpgsql SECURITY INVOKER SET search_path = pg_catalog AS $$
+DECLARE v_id uuid;
+BEGIN
+  INSERT INTO public.lab_worker_runs(worker_id,region)
+  VALUES (p_worker_id,p_region) RETURNING id INTO v_id;
+  RETURN v_id;
+END
+$$;
+
+-- Region and worker identity are taken from the run, never from a claim caller.
+-- All mutable RPCs lock run -> job in that order.
+CREATE FUNCTION public.lab_claim_prediction_jobs(
+  p_run_id uuid, p_limit integer DEFAULT 1, p_lease_seconds integer DEFAULT 300
+)
+RETURNS SETOF public.lab_prediction_jobs
+LANGUAGE plpgsql SECURITY INVOKER SET search_path = pg_catalog AS $$
+DECLARE
+  v_run public.lab_worker_runs;
+  v_job public.lab_prediction_jobs;
+  v_now timestamptz;
+  v_count integer := 0;
+BEGIN
+  IF p_limit IS NULL OR p_limit NOT BETWEEN 1 AND 50
+    OR p_lease_seconds IS NULL OR p_lease_seconds NOT BETWEEN 10 AND 900 THEN
+    RAISE EXCEPTION 'limit must be 1..50; lease_seconds must be 10..900';
+  END IF;
+  SELECT * INTO v_run FROM public.lab_worker_runs WHERE id = p_run_id FOR UPDATE;
+  IF NOT FOUND OR v_run.status <> 'RUNNING' THEN RAISE EXCEPTION 'run is not RUNNING'; END IF;
+  v_now := clock_timestamp();
+  -- Retire exhausted work even outside claim windows or after a race started.
+  -- Never retire an unexpired lease: its last allowed attempt may still finish.
+  -- Only job locks are taken here; old runs retain unresolved claim counts and
+  -- can be closed as FAILED/ABANDONED without reversing run -> job lock order.
+  WITH exhausted AS (
+    SELECT j.id FROM public.lab_prediction_jobs j
+    WHERE j.attempts >= j.max_attempts
+      AND (v_run.region = 'RESCUE' OR j.region = v_run.region)
+      AND (j.job_status IN ('QUEUED','RETRY')
+        OR (j.job_status = 'CLAIMED' AND j.lease_until <= v_now))
+    FOR UPDATE OF j SKIP LOCKED
+  )
+  UPDATE public.lab_prediction_jobs j SET
+    job_status = 'DEAD',
+    last_error = CASE WHEN j.job_status = 'CLAIMED'
+      THEN 'MAX_ATTEMPTS_EXCEEDED: LEASE_EXPIRED'
+      ELSE 'MAX_ATTEMPTS_EXCEEDED: ' || coalesce(j.last_error,'attempt budget exhausted') END,
+    claimed_by = NULL, claimed_at = NULL, lease_until = NULL,
+    claim_token = NULL, worker_run_id = NULL
+  FROM exhausted e WHERE j.id = e.id;
+  FOR v_job IN
+    SELECT j.* FROM public.lab_prediction_jobs j
+    JOIN public.lab_prediction_race_state r
+      ON (r.race_date,r.track,r.race_no,r.circuit) =
+         (j.race_date,j.track,j.race_no,j.circuit)
+    WHERE j.circuit = 'LOCAL'
+      AND r.prediction_status IN ('PENDING','RETRY')
+      AND NOT r.has_official_prediction AND NOT r.has_legacy_prediction
+      AND r.post_time > v_now
+      AND j.region = r.region
+      AND j.next_attempt_at <= v_now
+      AND j.attempts < j.max_attempts
+      AND (j.job_status IN ('QUEUED','RETRY')
+        OR (j.job_status = 'CLAIMED' AND j.lease_until <= v_now))
+      AND (
+        (v_run.region <> 'RESCUE' AND j.region = v_run.region
+          AND r.post_time >= v_now + interval '60 minutes'
+          AND r.post_time <= v_now + interval '150 minutes')
+        OR (v_run.region = 'RESCUE'
+          AND r.post_time >= v_now + interval '3 minutes'
+          AND r.post_time <= v_now + interval '70 minutes')
+      )
+    ORDER BY r.post_time, j.race_date, j.track, j.race_no, j.id
+    LIMIT p_limit
+    FOR UPDATE OF j SKIP LOCKED
+  LOOP
+    UPDATE public.lab_prediction_jobs SET
+      job_status = 'CLAIMED', attempts = attempts + 1,
+      last_error = CASE WHEN job_status = 'CLAIMED' THEN 'LEASE_EXPIRED' ELSE last_error END,
+      claimed_by = v_run.worker_id, claimed_at = v_now,
+      lease_until = v_now + make_interval(secs => p_lease_seconds),
+      claim_token = gen_random_uuid(), worker_run_id = p_run_id
+    WHERE id = v_job.id RETURNING * INTO v_job;
+    v_count := v_count + 1;
+    RETURN NEXT v_job;
+  END LOOP;
+  UPDATE public.lab_worker_runs SET claimed_count = claimed_count + v_count
+  WHERE id = p_run_id;
+END
+$$;
+
+-- A current, unexpired claim token fences off late/stale workers, even when the
+-- same worker_id is reused. DONE requires an existing official FROZEN record.
+CREATE FUNCTION public.lab_finish_prediction_job(
+  p_run_id uuid, p_job_id uuid, p_claim_token uuid, p_outcome text,
+  p_error text DEFAULT NULL, p_retry_seconds integer DEFAULT 60,
+  p_max_attempts integer DEFAULT NULL
+)
+RETURNS public.lab_prediction_jobs
+LANGUAGE plpgsql SECURITY INVOKER SET search_path = pg_catalog AS $$
+DECLARE
+  v_run public.lab_worker_runs;
+  v_job public.lab_prediction_jobs;
+  v_now timestamptz;
+  v_status text;
+BEGIN
+  IF p_outcome IS NULL OR p_outcome NOT IN ('DONE','RETRY','DEAD')
+    OR p_retry_seconds IS NULL OR p_retry_seconds NOT BETWEEN 1 AND 86400
+    OR (p_max_attempts IS NOT NULL AND p_max_attempts NOT BETWEEN 1 AND 100) THEN
+    RAISE EXCEPTION 'invalid outcome/retry_seconds/max_attempts';
+  END IF;
+  IF p_outcome <> 'DONE' AND (p_error IS NULL OR btrim(p_error) = '') THEN
+    RAISE EXCEPTION 'error is required for RETRY/DEAD';
+  END IF;
+  SELECT * INTO v_run FROM public.lab_worker_runs WHERE id = p_run_id FOR UPDATE;
+  IF NOT FOUND OR v_run.status <> 'RUNNING' THEN RAISE EXCEPTION 'run is not RUNNING'; END IF;
+  SELECT * INTO v_job FROM public.lab_prediction_jobs WHERE id = p_job_id FOR UPDATE;
+  v_now := clock_timestamp();
+  IF NOT FOUND OR v_job.job_status <> 'CLAIMED'
+    OR v_job.worker_run_id IS DISTINCT FROM p_run_id
+    OR v_job.claim_token IS DISTINCT FROM p_claim_token
+    OR v_job.claimed_by IS DISTINCT FROM v_run.worker_id
+    OR v_job.lease_until <= v_now THEN
+    RAISE EXCEPTION 'stale or expired claim';
+  END IF;
+  IF p_outcome = 'DONE' AND NOT EXISTS (
+    SELECT 1 FROM public.official_predictions p
+    WHERE (p.race_date,p.track,p.race_no,p.circuit) =
+      (v_job.race_date,v_job.track,v_job.race_no,v_job.circuit)
+      AND p.status = 'FROZEN'
+  ) THEN
+    RAISE EXCEPTION 'DONE requires an official FROZEN prediction';
+  END IF;
+  v_status := CASE
+    WHEN p_outcome = 'RETRY'
+      AND v_job.attempts >= least(coalesce(p_max_attempts,v_job.max_attempts),v_job.max_attempts)
+      THEN 'DEAD'
+    ELSE p_outcome END;
+  UPDATE public.lab_prediction_jobs SET
+    job_status = v_status, last_error = CASE WHEN v_status = 'DONE' THEN NULL ELSE p_error END,
+    next_attempt_at = CASE WHEN v_status = 'RETRY'
+      THEN v_now + make_interval(secs => p_retry_seconds) ELSE next_attempt_at END,
+    claimed_by = NULL, claimed_at = NULL, lease_until = NULL,
+    claim_token = NULL, worker_run_id = NULL
+  WHERE id = p_job_id RETURNING * INTO v_job;
+  UPDATE public.lab_worker_runs SET
+    completed_count = completed_count + (v_status = 'DONE')::integer,
+    retry_count = retry_count + (v_status = 'RETRY')::integer,
+    failed_count = failed_count + (v_status = 'DEAD')::integer,
+    last_error = CASE WHEN v_status = 'DONE' THEN last_error ELSE p_error END
+  WHERE id = p_run_id;
+  RETURN v_job;
+END
+$$;
+
+CREATE FUNCTION public.lab_finish_worker_run(
+  p_run_id uuid, p_status text DEFAULT 'SUCCEEDED', p_error text DEFAULT NULL
+)
+RETURNS public.lab_worker_runs
+LANGUAGE plpgsql SECURITY INVOKER SET search_path = pg_catalog AS $$
+DECLARE v_run public.lab_worker_runs; v_now timestamptz;
+BEGIN
+  IF p_status IS NULL OR p_status NOT IN ('SUCCEEDED','FAILED','ABANDONED') THEN
+    RAISE EXCEPTION 'invalid terminal run status';
+  END IF;
+  SELECT * INTO v_run FROM public.lab_worker_runs WHERE id = p_run_id FOR UPDATE;
+  IF NOT FOUND OR v_run.status <> 'RUNNING' THEN RAISE EXCEPTION 'run is not RUNNING'; END IF;
+  v_now := clock_timestamp();
+  IF EXISTS (SELECT 1 FROM public.lab_prediction_jobs
+    WHERE worker_run_id = p_run_id AND job_status = 'CLAIMED'
+      AND (lease_until > v_now OR p_status = 'SUCCEEDED')) THEN
+    RAISE EXCEPTION 'run has unfinished claims';
+  END IF;
+  IF p_status = 'SUCCEEDED'
+    AND v_run.claimed_count <> v_run.completed_count + v_run.retry_count + v_run.failed_count THEN
+    RAISE EXCEPTION 'run has lost claims; use FAILED or ABANDONED';
+  END IF;
+  UPDATE public.lab_worker_runs SET status = p_status,
+    finished_at = v_now, last_error = coalesce(p_error,last_error)
+  WHERE id = p_run_id RETURNING * INTO v_run;
+  RETURN v_run;
+END
+$$;
+
+-- Health includes unqueued races and races whose registry status is not claimable.
+-- FROZEN counts registry/official FROZEN or legacy saved output. Official rows of
+-- any status block claims, but are not silently counted as FROZEN.
+CREATE VIEW public.lab_prediction_health_races WITH (security_invoker = true) AS
+SELECT r.*, j.id AS job_id, j.job_status, j.attempts, j.last_error,
+  j.claimed_by, j.lease_until, j.next_attempt_at,
+  (r.prediction_status = 'FROZEN' OR r.has_frozen_prediction OR r.has_legacy_prediction) AS frozen,
+  (j.job_status = 'CLAIMED' AND j.lease_until <= statement_timestamp()) AS lease_expired,
+  (NOT r.has_official_prediction AND NOT r.has_legacy_prediction
+    AND r.post_time > statement_timestamp()
+    AND r.post_time <= statement_timestamp() + interval '70 minutes') AS missing_within_70,
+  CASE WHEN NOT r.has_official_prediction AND NOT r.has_legacy_prediction
+    AND r.post_time > statement_timestamp()
+    AND r.post_time <= statement_timestamp() + interval '45 minutes'
+    THEN 'URGENT_MISSING_PREDICTION' END AS alert
+FROM public.lab_prediction_race_state r
+LEFT JOIN public.lab_prediction_jobs j
+  ON (j.race_date,j.track,j.race_no,j.circuit) =
+     (r.race_date,r.track,r.race_no,r.circuit);
+
+CREATE VIEW public.lab_prediction_health_today WITH (security_invoker = true) AS
+SELECT (statement_timestamp() AT TIME ZONE 'Asia/Tokyo')::date AS race_date,
+  count(*) AS local_total,
+  count(*) FILTER (WHERE frozen) AS frozen,
+  count(*) FILTER (WHERE job_status = 'QUEUED') AS queued,
+  count(*) FILTER (WHERE job_status = 'CLAIMED') AS claimed,
+  count(*) FILTER (WHERE job_status = 'RETRY') AS retry,
+  count(*) FILTER (WHERE job_status = 'DEAD') AS dead,
+  count(*) FILTER (WHERE lease_expired) AS expired_claimed,
+  count(*) FILTER (WHERE missing_within_70) AS missing_within_70,
+  count(*) FILTER (WHERE alert = 'URGENT_MISSING_PREDICTION') AS urgent_missing_prediction,
+  count(*) FILTER (WHERE region IS NULL) AS unmapped_tracks,
+  count(*) FILTER (WHERE post_time IS NULL) AS unknown_post_time
+FROM public.lab_prediction_health_races
+WHERE race_date = (statement_timestamp() AT TIME ZONE 'Asia/Tokyo')::date;
+
+REVOKE ALL ON public.lab_prediction_race_state, public.lab_prediction_health_races,
+  public.lab_prediction_health_today FROM PUBLIC, anon, authenticated;
+GRANT SELECT ON public.lab_prediction_race_state, public.lab_prediction_health_races,
+  public.lab_prediction_health_today TO service_role;
+REVOKE ALL ON FUNCTION public.lab_prediction_region(text),
+  public.lab_queue_touch_updated_at(), public.lab_enqueue_prediction_jobs(date),
+  public.lab_start_worker_run(text,text), public.lab_claim_prediction_jobs(uuid,integer,integer),
+  public.lab_finish_prediction_job(uuid,uuid,uuid,text,text,integer,integer),
+  public.lab_finish_worker_run(uuid,text,text) FROM PUBLIC, anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.lab_prediction_region(text),
+  public.lab_enqueue_prediction_jobs(date), public.lab_start_worker_run(text,text),
+  public.lab_claim_prediction_jobs(uuid,integer,integer),
+  public.lab_finish_prediction_job(uuid,uuid,uuid,text,text,integer,integer),
+  public.lab_finish_worker_run(uuid,text,text) TO service_role;
+
+COMMIT;
