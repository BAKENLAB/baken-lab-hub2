+  const existing=sql("SELECT count(*) FROM pg_roles WHERE rolname IN ('anon','authenticated','service_role');",'postgres');
+  assert.equal(existing,'0','use a fresh local test cluster; do not use your normal DB');
+  sql(`CREATE DATABASE ${db};`,'postgres');
+  sql(fixture);
+  sql(migration);
+  console.log('Disposable database retained for inspection:',db,'socket:',socket);
+});
