  "scope": "DERIVED_LOCATORS_ONLY",
  "query_template_not_directly_executable": "BEGIN READ ONLY;\nWITH input(no,ord,horse_name,hid,event_date,track,rno,finish,clock,f3,dist,going,corners) AS (VALUES /* INSERT AUTHORIZED EXISTING DERIVED ROWS; NEVER COMMIT RAW VALUES */),\ni AS (SELECT *,CASE WHEN clock~'^[0-9]+:[0-5][0-9][.][0-9]$' THEN (split_part(clock,':',1)::numeric*60+split_part(clock,':',2)::numeric)*10 END ticks FROM input WHERE event_date<'2026-10-10'),\na AS (SELECT i.*,coalesce(h.rows,'[]'::jsonb) archive_rows,coalesce(j.rows,'[]'::jsonb) jra_rows,coalesce(o.rows,'[]'::jsonb) settlement_rows,coalesce(w.rows,'[]'::jsonb) snapshot_rows\nFROM i LEFT JOIN LATERAL (\n SELECT jsonb_agg(jsonb_build_object('row_id',h.id,'race_id',h.race_id,'historical_no',h.horse_no,'finish_match',h.finish=i.finish,'clock_match',CASE WHEN h.time_raw~'^[0-9]{1,2}[0-5][0-9][0-9]$' THEN left(h.time_raw,length(h.time_raw)-3)::numeric*600+right(h.time_raw,3)::numeric=i.ticks WHEN h.time_raw~'^[0-9]+:[0-5][0-9][.][0-9]$' THEN (split_part(h.time_raw,':',1)::numeric*60+split_part(h.time_raw,':',2)::numeric)*10=i.ticks END,'f3_match',h.final3f::text::numeric=i.f3::numeric,'distance_match',h.distance=i.dist,'going_match',h.going=i.going,'early_match',CASE WHEN i.corners~'^[0-9]+(-[0-9]+)*$' THEN h.early_pos=split_part(i.corners,'-',1)::int END,'final_turn_match',CASE WHEN i.corners~'^[0-9]+(-[0-9]+)*$' THEN h.final_turn_pos=regexp_replace(i.corners,'^.*-','')::int END,'margin_present',nullif(h.margin,'') IS NOT NULL,'weight_present',nullif(h.weight_carried,'') IS NOT NULL,'field_size',h.field_size,'native_id_available',false,'capture_available',false)) rows FROM public.horse_runs h WHERE h.race_date::text=i.event_date AND h.track=i.track AND h.race_no=i.rno AND h.horse_name=i.horse_name\n) h ON true LEFT JOIN LATERAL (\n SELECT jsonb_agg(jsonb_build_object('race_id',r.id,'row_id',u.id,'historical_no',u.horse_no,'native_jra_ref',u.horse_ref,'finish_match',u.finish=i.finish,'clock_match',u.time_raw=i.clock,'f3_match',u.final3f=i.f3::numeric,'distance_match',r.distance=i.dist,'going_match',r.going=i.going,'lap_available',nullif(r.halon_times,'') IS NOT NULL,'corners_available',nullif(u.corner_positions,'') IS NOT NULL,'source_checked',r.source_checked_at,'pre_cutoff',r.source_checked_at<='2026-10-09 15:43:39+00'::timestamptz AND r.updated_at<='2026-10-09 15:43:39+00'::timestamptz AND u.updated_at<='2026-10-09 15:43:39+00'::timestamptz)) rows FROM public.jra_lab_races r JOIN public.jra_lab_runs u ON u.race_id=r.id WHERE r.race_date::text=i.event_date AND r.track=regexp_replace(i.track,'^J','') AND r.race_no=i.rno AND u.horse_name=i.horse_name AND i.track LIKE 'J%'\n) j ON true LEFT JOIN LATERAL (\n SELECT jsonb_agg(jsonb_build_object('result_id',z.id,'source',z.source,'settled_at',z.settled_at,'historical_no',f->>'horse_no','finish_match',f->>'finish'=i.finish::text,'clock_literal_match',coalesce(f->>'time',f->>'time_raw')=i.clock,'native_id_field_exists',f?'horse_ref' OR f?'horse_id')) rows FROM public.official_results z CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(z.result->'finishers')='array' THEN z.result->'finishers' ELSE '[]'::jsonb END) f WHERE z.race_date::text=i.event_date AND z.track=regexp_replace(i.track,'^J','') AND z.race_no=i.rno AND z.circuit=CASE WHEN i.track LIKE 'J%' THEN 'JRA' ELSE 'LOCAL' END AND z.created_at<='2026-10-09 15:43:39+00'::timestamptz AND z.settled_at<='2026-10-09 15:43:39+00'::timestamptz AND f->>'horse_name'=i.horse_name\n) o ON true LEFT JOIN LATERAL (\n SELECT jsonb_agg(jsonb_build_object('snapshot_id',s.id,'captured_at',s.captured_at,'witness_ordinal',e.ord,'historical_no',e.j->>'pastHorseNo','source_ref',e.j->>'sourceRef','source_checked_at',e.j->>'sourceCheckedAt')) rows FROM private.lab_preclaim_evidence_snapshots_v1 s CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(s.evidence->'packet'->'evidence')='array' THEN s.evidence->'packet'->'evidence' ELSE '[]'::jsonb END) WITH ORDINALITY e(j,ord) WHERE s.circuit='LOCAL' AND s.captured_at<='2026-10-09 15:43:39+00'::timestamptz AND s.captured_at<s.official_post_time AND s.as_of<=s.captured_at AND e.j->>'identityVerifiedBy'='OFFICIAL_HORSE_REF' AND substring(e.j->>'horseRef' from 'k_lineageLoginCode=([0-9]{11})')=i.hid AND e.j->'pastRace'->>'raceDate'=i.event_date AND e.j->'pastRace'->>'track'=i.track AND e.j->'pastRace'->>'raceNo'=i.rno::text AND (e.j->>'sourceCheckedAt')::timestamptz<=s.as_of\n) w ON true)\nSELECT no,ord,event_date,track,rno,archive_rows,jra_rows,settlement_rows,snapshot_rows FROM a ORDER BY no,ord;\nROLLBACK;",
