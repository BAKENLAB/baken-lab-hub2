  "query": "BEGIN READ ONLY;\nWITH t AS (SELECT id,race_date FROM public.jra_live_races WHERE race_date='2026-11-23' AND track='東京' AND race_no=12),\nc AS (SELECT h.horse_no no,h.horse_name,h.horse_ref,h.source_checked_at cutoff,j,ord,substring(j->>'source_ref' from '([0-9]{2})[0-9]{8}/[0-9A-F]{2}$')::int rno FROM t JOIN public.jra_live_runners h ON h.live_race_id=t.id CROSS JOIN LATERAL jsonb_array_elements(h.past_runs) WITH ORDINALITY p(j,ord) WHERE j->>'race_date'<t.race_date::text AND (h.horse_no,ord) IN ((1,1),(2,1),(3,2),(3,3),(3,4),(4,1),(4,2),(4,3),(5,1),(7,1),(8,1),(8,2),(9,1),(9,2),(10,1),(10,3),(11,1),(12,1),(12,3),(14,1),(14,3),(17,1),(18,1),(18,4))),\na AS (SELECT c.*,coalesce(l.rows,'[]'::jsonb) prior_card_rows,coalesce(h.rows,'[]'::jsonb) generic_rows,coalesce(w.rows,'[]'::jsonb) other_card_witnesses\nFROM c LEFT JOIN LATERAL (\n SELECT jsonb_agg(jsonb_build_object('race_id',r.id,'runner_id',u.id,'same_native_id',coalesce(substring(u.horse_ref from 'CNAME=pw01dud[01]0([0-9]{10})/')=substring(c.horse_ref from 'CNAME=pw01dud[01]0([0-9]{10})/'),false),'capture',u.source_checked_at,'updated',u.updated_at,'pre_cutoff',r.updated_at<=c.cutoff AND u.updated_at<=c.cutoff AND u.source_checked_at<=c.cutoff)) rows FROM public.jra_live_races r JOIN public.jra_live_runners u ON u.live_race_id=r.id WHERE r.race_date::text=c.j->>'race_date' AND r.track=c.j->>'track' AND r.race_no=c.rno AND u.horse_no::text=c.j->>'horse_no' AND u.horse_name=c.horse_name\n) l ON true LEFT JOIN LATERAL (\n SELECT jsonb_agg(jsonb_build_object('row_id',h.id,'race_no',h.race_no,'finish_match',coalesce(h.finish::text=c.j->>'finish',false),'clock_literal_match',coalesce(h.time_raw=c.j->>'time_raw',false),'native_id_and_capture_available',false)) rows FROM public.horse_runs h WHERE h.race_date::text=c.j->>'race_date' AND h.track=c.j->>'track' AND (c.rno IS NULL OR h.race_no=c.rno) AND h.horse_no::text=c.j->>'horse_no' AND h.horse_name=c.horse_name\n) h ON true LEFT JOIN LATERAL (\n SELECT jsonb_agg(jsonb_build_object('race_id',r.id,'runner_id',u.id,'ordinal',k.ord,'capture',u.source_checked_at,'updated',u.updated_at,'finish_match',coalesce(k.j->>'finish'=c.j->>'finish',false),'clock_match',coalesce(k.j->>'time_raw'=c.j->>'time_raw',false))) rows\n FROM public.jra_live_runners u JOIN public.jra_live_races r ON r.id=u.live_race_id CROSS JOIN LATERAL jsonb_array_elements(u.past_runs) WITH ORDINALITY k(j,ord)\n WHERE r.race_date>'2026-01-01' AND r.race_date<'2026-11-23' AND r.race_date::text>c.j->>'race_date' AND r.updated_at<=c.cutoff AND u.updated_at<=c.cutoff AND u.source_checked_at<=c.cutoff AND u.horse_name=c.horse_name AND substring(u.horse_ref from 'CNAME=pw01dud[01]0([0-9]{10})/')=substring(c.horse_ref from 'CNAME=pw01dud[01]0([0-9]{10})/') AND k.j->>'race_date'=c.j->>'race_date' AND k.j->>'track'=c.j->>'track' AND k.j->>'horse_no'=c.j->>'horse_no' AND (c.rno IS NULL OR substring(k.j->>'source_ref' from '([0-9]{2})[0-9]{8}/[0-9A-F]{2}$')::int=c.rno)\n) w ON true)\nSELECT no,ord,j->>'race_date' date,j->>'track' track,rno,prior_card_rows,generic_rows,other_card_witnesses FROM a ORDER BY no,ord;\nROLLBACK;",
