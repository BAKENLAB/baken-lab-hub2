  "query": "BEGIN READ ONLY;\nWITH selected(no,ord,row_id) AS (VALUES (1,1,256933::bigint),(1,2,236380::bigint),(1,3,236075::bigint),(1,4,189021::bigint),(1,5,176134::bigint),(2,2,257348::bigint),(2,3,244288::bigint),(2,4,221681::bigint),(2,5,193657::bigint),(3,2,256949::bigint),(3,3,244222::bigint),(3,4,230328::bigint),(3,5,216831::bigint),(4,2,257333::bigint),(4,3,257066::bigint),(4,4,216114::bigint),(4,5,202996::bigint),(5,3,215886::bigint),(5,4,202679::bigint),(5,5,202208::bigint),(6,2,257340::bigint),(6,3,256738::bigint),(6,4,244027::bigint),(6,5,226939::bigint),(7,2,257350::bigint),(7,3,256951::bigint),(7,4,243949::bigint),(7,5,230103::bigint),(8,2,257451::bigint),(8,3,256735::bigint),(8,4,244224::bigint),(8,5,170861::bigint),(9,2,257449::bigint),(9,3,256737::bigint),(9,4,244128::bigint),(9,5,230331::bigint),(10,2,257363::bigint),(10,3,256860::bigint),(11,2,257338::bigint),(11,3,256947::bigint),(11,4,230287::bigint),(11,5,216987::bigint)),\nevents AS (SELECT DISTINCT h.race_id FROM selected s JOIN public.horse_runs h ON h.id=s.row_id),\nfield AS (SELECT h.race_id,count(*) n,count(DISTINCT h.horse_no) unique_no,count(DISTINCT h.finish) unique_finish,min(h.field_size) min_field,max(h.field_size) max_field,count(*) FILTER(WHERE h.finish>0 AND h.time_raw IS NOT NULL AND h.final3f>0) numeric_rows FROM events e JOIN public.horse_runs h ON h.race_id=e.race_id GROUP BY h.race_id)\nSELECT s.no,s.ord,h.id row_id,h.race_id,h.horse_no historical_no,f.n,f.unique_no,f.unique_finish,f.min_field,f.max_field,f.numeric_rows,(f.n=f.min_field AND f.min_field=f.max_field AND f.unique_no=f.n AND f.unique_finish=f.n AND f.numeric_rows=f.n) full_numeric_candidate FROM selected s JOIN public.horse_runs h ON h.id=s.row_id JOIN field f ON f.race_id=h.race_id WHERE h.race_date<'2026-10-10' ORDER BY s.no,s.ord;\nROLLBACK;",
