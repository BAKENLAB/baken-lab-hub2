{
  "schema": "stage19-settlement-fields-v1.7",
  "query": "BEGIN READ ONLY;\nWITH t AS (SELECT id,race_date FROM public.jra_live_races WHERE race_date='2026-11-23' AND track='東京' AND race_no=12),\nc AS (SELECT h.horse_no no,h.horse_name,h.source_checked_at cutoff,j,ord,substring(j->>'source_ref' from '([0-9]{2})[0-9]{8}/[0-9A-F]{2}$')::int rno FROM t JOIN public.jra_live_runners h ON h.live_race_id=t.id CROSS JOIN LATERAL jsonb_array_elements(h.past_runs) WITH ORDINALITY p(j,ord) WHERE j->>'race_date'<t.race_date::text AND (h.horse_no,ord) IN ((1,1),(4,1),(4,2),(7,1),(8,1),(9,1),(9,2),(12,1),(14,1),(17,1),(18,1))),\nw AS (SELECT c.*,s.id result_id,s.settled_at,s.created_at,f.h FROM c JOIN public.official_results s ON s.circuit='JRA' AND s.source='JRA_OFFICIAL' AND s.race_date::text=c.j->>'race_date' AND s.track=c.j->>'track' AND s.race_no=c.rno AND s.created_at<=c.cutoff AND s.settled_at<=c.cutoff CROSS JOIN LATERAL jsonb_array_elements(CASE WHEN jsonb_typeof(s.result->'finishers')='array' THEN s.result->'finishers' ELSE '[]'::jsonb END) f(h) WHERE f.h->>'horse_no'=c.j->>'horse_no' AND f.h->>'horse_name'=c.horse_name)\nSELECT no,ord,result_id,settled_at,created_at,h->>'finish' IS NOT NULL finish_available,CASE WHEN h->>'finish' IS NOT NULL AND j->>'finish' IS NOT NULL THEN h->>'finish'=j->>'finish' END finish_match,coalesce(h->>'time',h->>'time_raw') IS NOT NULL clock_available,CASE WHEN coalesce(h->>'time',h->>'time_raw') IS NOT NULL AND j->>'time_raw' IS NOT NULL THEN coalesce(h->>'time',h->>'time_raw')=j->>'time_raw' END clock_literal_match,coalesce(h->>'final3f',h->>'agari') IS NOT NULL final3f_available,CASE WHEN coalesce(h->>'final3f',h->>'agari')~'^[0-9]+([.][0-9]+)?$' AND j->>'final3f'~'^[0-9]+([.][0-9]+)?$' THEN coalesce(h->>'final3f',h->>'agari')::numeric=(j->>'final3f')::numeric END final3f_match,(h ? 'horse_ref' OR h ? 'horse_id') AS native_id_field_exists\nFROM w ORDER BY no,ord;\nROLLBACK;",
